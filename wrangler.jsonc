{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "brainup",
  "main": "dist-cloudflare/server/index.js",
  "compatibility_date": "2026-11-10",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "dist-cloudflare/public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "brainup-production",
      "database_id": "a906f74a-ce02-4b50-9b0d-ec7358825398",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "build": {
    "command": "npm run build:cloudflare"
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "keep_vars": true,
  "vars": {
    "APP_ORIGIN": "https://brainup.kgura2012.workers.dev",
    "TELEGRAM_NEWS_CHANNEL": "@BrainUp_Official",
    "TELEGRAM_NEWS_URL": "https://t.me/BrainUp_Official"
  }
}
