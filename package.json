{
  "name": "brainup",
  "version": "4.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/preview.mjs",
    "build": "node scripts/build-brainup.mjs",
    "test": "node --test tests/*.test.mjs",
    "build:cloudflare": "node scripts/build-brainup.mjs --target=cloudflare",
    "cf:login": "wrangler login --device --browser=false --scopes account:read user:read workers_scripts:write d1:write",
    "cf:whoami": "wrangler whoami",
    "cf:db:create": "wrangler d1 create brainup-production --binding DB --update-config",
    "cf:db:migrate": "wrangler d1 migrations apply DB --remote",
    "cf:dev": "npm run build:cloudflare && wrangler dev",
    "cf:check": "npm run build:cloudflare && wrangler deploy --dry-run",
    "cf:deploy": "node scripts/cloudflare-deploy.mjs",
    "cf:db:import": "node scripts/cloudflare-import.mjs"
  },
  "devDependencies": {
    "wrangler": "4.160.0"
  }
}
